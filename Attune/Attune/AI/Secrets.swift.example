//  TEMPLATE ONLY — copy this file to Secrets.swift and fill in real values.
//  Secrets.swift is gitignored and must never be committed.
//  This file uses the .example extension so Xcode does not compile it.
//
//  1. Deploy backend/openai-proxy (see its README)
//  2. Set Worker secrets OPENAI_API_KEY + APP_PROXY_TOKEN
//  3. Paste the Worker URL and the same APP_PROXY_TOKEN below
//

import Foundation

/// API endpoints and tokens for external services (no OpenAI key in the app).
enum Secrets {
    /// Cloudflare Worker base URL with no trailing slash.
    /// Example: "https://attune-openai-proxy.your-subdomain.workers.dev"
    static let proxyBaseURL = "https://YOUR_WORKER.workers.dev"

    /// Same value as the Worker secret APP_PROXY_TOKEN.
    static let appProxyToken = "REPLACE_WITH_LONG_RANDOM_TOKEN"
}
